#!/usr/bin/env bash
# Launcher for the omp issues board.
#
# Resolves its own real path through symlinks (so a symlink in ~/.local/bin works)
# and runs the board's TypeScript entrypoint with Bun. Bun resolves the monorepo
# root tsconfig `paths` from the entrypoint's location, so the board works from any
# working directory.
set -euo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
		/*) self=$link ;;
		*) self=$(dirname "$self")/$link ;;
	esac
done
pkg=$(cd -- "$(dirname -- "$self")/.." && pwd -P)

# omp's TypeScript needs a recent Bun (the omp host's `packageManager` floor);
# an older one cannot resolve the `@oh-my-pi/*` tsconfig paths. A distro Bun
# often comes first on the PATH a GUI app (Tern) hands its children, so take
# the first candidate new enough rather than the first one found.
# OMP_BOARD_BUN forces a binary.
min_bun=1.4.4
bun=${OMP_BOARD_BUN:-}
if [ -z "$bun" ]; then
	found=()
	for candidate in "$(command -v bun || true)" "$HOME/.bun/bin/bun" "$HOME/.local/bin/bun"; do
		[ -n "$candidate" ] && [ -x "$candidate" ] || continue
		version=$("$candidate" --version 2>/dev/null || true)
		found+=("$candidate ${version:-?}")
		if [ -n "$version" ] && printf '%s\n%s\n' "$min_bun" "$version" | sort -V -C; then
			bun=$candidate
			break
		fi
	done
	if [ -z "$bun" ]; then
		printf 'omp-board: needs bun >= %s; found: %s\n' "$min_bun" "${found[*]:-none}" >&2
		exit 127
	fi
fi

# `e` runs nvim as a child of bun. If bun is wrapped in a bwrap sandbox that binds
# nvim's config, plugin and state dirs only when SANDBOX_NVIM=1 is set, the nested
# nvim inherits that sandbox; the variable is harmless everywhere else.
export SANDBOX_NVIM=1

exec "$bun" "$pkg/src/main.ts" "$@"
